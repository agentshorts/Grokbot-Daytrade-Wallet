# Local MCP client settings. Copy to .env and fill in the key.
# Never commit .env. The host reads MCP_API_KEY and does not read MCP_URL.

# Admin API key for http://127.0.0.1:5050/mcp.
# Create it in the admin UI, or set a new value of at least 8 characters.
MCP_API_KEY=

# Loopback endpoint for the MCP client.
MCP_URL=http://127.0.0.1:5050/mcp
